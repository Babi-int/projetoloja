# ─────────────────────────────────────────────────────────
# Backend — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o .env com segredos reais.
# ─────────────────────────────────────────────────────────

# ── Firebase Admin SDK ───────────────────────────────────
# Obtenha em: Firebase Console → Configurações do projeto
#             → Contas de serviço → Gerar nova chave privada
# O arquivo JSON baixado contém os três campos abaixo.

FIREBASE_PROJECT_ID="seu-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu-project-id.iam.gserviceaccount.com"

# Cole o valor de "private_key" do JSON. Mantenha os \n literais — o código faz o replace automaticamente.
# Exemplo: "-----BEGIN PRIVATE KEY-----\nMIIEvg...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA\n-----END PRIVATE KEY-----\n"

# ── JWT ─────────────────────────────────────────────────
# Gere um segredo forte em produção:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-por-um-valor-forte-em-producao"
JWT_EXPIRES_IN="1d"

# ── Servidor ─────────────────────────────────────────────
# Render define PORT automaticamente (normalmente 10000). Não altere em produção.
PORT=3333
HOST=0.0.0.0

# ── CORS — origem permitida do frontend ──────────────────
# LOCAL: URL do Vite (sem barra no final)
FRONTEND_URL="http://localhost:5173"

# PRODUÇÃO (Render): cole a URL exata do seu site na Vercel.
# Para múltiplas origens, separe por vírgula SEM espaços no início/fim.
# Exemplo:
# FRONTEND_URL="https://meu-erp.vercel.app"
# FRONTEND_URL="http://localhost:5173,https://meu-erp.vercel.app"
