FIREBASE_PROJECT_ID="seu-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA\n-----END PRIVATE KEY-----\n"
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="1d"
PORT=3333
# Ouvindo em todas as interfaces (padrao). Use 127.0.0.1 para aceitar so este PC.
HOST=0.0.0.0
# --- Render (Web Service > Environment) ---
# Copie cada chave/valor abaixo (ou equivalente) para o painel do servico da API.
# FRONTEND_URL = origem exata do front na Vercel, sem barra no fim, ex.: https://seu-app.vercel.app
# AUTH_DISABLED = true  → entrada sem JWT no painel (so use se o risco for aceitavel)

FRONTEND_URL="http://localhost:5173"

# Acesso sem senha na API: desliga verificacao JWT em todas as rotas protegidas. NUNCA em ambiente publico sem outra camada de seguranca.
AUTH_DISABLED=true
