# ─────────────────────────────────────────────────────────
# Frontend — variáveis de ambiente (Vite)
# Copie para .env (desenvolvimento local) ou configure no
# painel da Vercel em Settings → Environment Variables.
# Variáveis VITE_* ficam embutidas no bundle — não coloque segredos aqui.
# ─────────────────────────────────────────────────────────

# ── DESENVOLVIMENTO LOCAL ─────────────────────────────────
# Backend rodando na mesma máquina:
VITE_API_URL="http://localhost:3333/api"

# Backend em outro computador na mesma rede Wi-Fi/LAN:
# VITE_API_URL="http://192.168.0.15:3333/api"
#   (substitua pelo IP da máquina que roda o backend — inclua sempre :3333)

# ── PRODUÇÃO — ESCOLHA UMA DAS DUAS OPÇÕES ABAIXO ────────

# OPÇÃO A — PROXY VERCEL (recomendada, sem CORS no browser)
# ─────────────────────────────────────────────────────────
# NÃO defina VITE_API_URL. O frontend usará /api (mesmo domínio).
# No painel da Vercel, adicione a variável de ambiente:
#   VERCEL_BACKEND_URL = https://meu-backend.onrender.com
#   (sem /api no final; marque disponível para Edge Middleware)
# No backend (Render), defina:
#   FRONTEND_URL = https://meu-erp.vercel.app

# OPÇÃO B — URL DIRETA (mais simples, expõe a URL do backend)
# ─────────────────────────────────────────────────────────
# No painel da Vercel, adicione:
#   VITE_API_URL = https://meu-backend.onrender.com/api
# No backend (Render), defina:
#   FRONTEND_URL = https://meu-erp.vercel.app
